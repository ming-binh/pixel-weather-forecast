<?xml version="1.0" encoding="utf-8"?>
<!-- The whole widget is one pre-rendered pixel-art PNG pushed from Dart via
     `HomeWidget.renderFlutterWidget` — a native App Widget can't run
     Flutter's custom canvas painting, so there is nothing else to lay out
     here besides the click target. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_img"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="Pixel Weather" />
</FrameLayout>
